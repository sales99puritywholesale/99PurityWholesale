# Copy this file to  .env.scratch.local  in the REPOSITORY ROOT (git-ignored by the ".env*.local" rule) and fill it in.
# Names only here. NEVER commit the filled-in file. NEVER use the dev or any production project.
# Do NOT put a service-role / secret key anywhere in this file; the harness refuses one.

# 20-character project reference of the SCRATCH project (the part before .supabase.co)
P2_SCRATCH_PROJECT_REF=
# SESSION pooler connection string, port 5432 (Dashboard -> Connect -> Session pooler). Carries the database password.
P2_SCRATCH_DB_URL=
# https://<project ref>.supabase.co
P2_SCRATCH_API_URL=
# The PUBLIC publishable/anon key of the scratch project
P2_SCRATCH_ANON_KEY=
# PostgreSQL major version shown in the scratch project's settings (required; no default)
P2_EXPECTED_PG_MAJOR=
# Optional safety net: comma-separated project refs that must NEVER be targeted (put the dev project ref here)
P2_FORBIDDEN_PROJECT_REFS=
