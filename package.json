{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck:portal": "tsc -p tsconfig.portal.json",
    "lint:portal": "eslint \"src/app/(portal)\" src/app/api/v1 src/app/api/cron src/components/portal src/lib/portal src/portal src/middleware.ts tests --ext .ts,.tsx --max-warnings 0",
    "check:portal": "npm run typecheck:portal && npm run lint:portal && npm test",
    "check:sql": "node tests/db/check-sql.mjs",
    "test:db:guard": "node --test tests/db/guard.test.mjs",
    "db:apply:scratch": "node tests/db/apply-migrations.mjs",
    "db:reset:scratch": "node tests/db/reset-scratch.mjs --yes",
    "test:db": "node --test --test-concurrency=1 --test-timeout=900000 tests/db/*.test.mjs",
    "db:local:start": "node tests/db/local-stack.mjs start",
    "db:local:stop": "node tests/db/local-stack.mjs stop",
    "db:local:status": "node tests/db/local-stack.mjs status",
    "db:local:env": "node tests/db/local-stack.mjs env",
    "db:local:verify": "node tests/db/local-verify.mjs",
    "db:local:apply": "node tests/db/local-stack.mjs apply",
    "test:db:local": "node tests/db/run-local.mjs",
    "dev:demo": "node scripts/dev-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.15.0",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "next-intl": "^4.11.2",
    "next-mdx-remote": "^6.0.0",
    "next-pwa": "^5.6.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "pg": "8.13.1",
    "postcss": "^8",
    "supabase": "2.121.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
