# Environment variable NAMES with safe placeholders only. Copy to .env.local (git-ignored) and fill in locally.
# Never commit real values. Never put a secret in a NEXT_PUBLIC_* variable.

# --- Public website (existing; unchanged) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BASE_URL=
RESEND_API_KEY=
SENDER_EMAIL=
NOTIFICATION_EMAIL=
LEADS_SHEET_URL=

# --- Authenticated portal (P1) ---
# Master switch. The portal (/client, /admin, /login, /auth) answers 404 unless this is exactly the word: true
# Any other value, or no value, keeps the portal OFF (fail closed). Keep it unset on production until approved.
PORTAL_ENABLED=
# Supabase project URL and the PUBLIC publishable (anon) key of the matching environment (one project per environment).
# These two are safe for the browser by design. The service-role key is NOT used by the portal in P1; never add it here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
